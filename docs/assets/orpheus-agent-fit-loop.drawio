ed=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=2;strokeColor=#D3912A;fontColor=#203247;fontStyle=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=16;spacingTop=18;" parent="1" vertex="1"><mxGeometry x="570" y="220" width="180" height="150" as="geometry" /></mxCell><mxCell id="step-inspect" value="&lt;b&gt;PART INSPECTION&lt;/b&gt;&lt;br&gt;Frames + source audio&lt;br&gt;Local Part clock&lt;br&gt;&lt;font color='#50667D'&gt;tool&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=2;strokeColor=#2F80ED;fontColor=#203247;fontStyle=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=16;spacingTop=18;" parent="1" vertex="1"><mxGeometry x="320" y="550" width="182" height="128" as="geometry" /></mxCell><mxCell id="step-fit" value="&lt;b&gt;FIT CANDIDATE&lt;/b&gt;&lt;br&gt;Use accepted windows&lt;br&gt;Render one revision&lt;br&gt;&lt;font color='#50667D'&gt;tool&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=2;strokeColor=#FF5A36;fontColor=#203247;fontStyle=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=16;spacingTop=18;" parent="1" vertex="1"><mxGeometry x="570" y="550" width="180" height="128" as="geometry" /></mxCell><mxCell id="step-measure" value="&lt;b&gt;MEASURE&lt;/b&gt;&lt;br&gt;Loudness · peak · timing&lt;br&gt;&lt;font color='#50667D'&gt;tool&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=2;strokeColor=#2F80ED;fontColor=#203247;fontStyle=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=16;spacingTop=18;" parent="1" vertex="1"><mxGeometry x="818" y="490" width="180" height="68" as="geometry" /></mxCell><mxCell id="step-selection" value="&lt;b&gt;SELECT OR STOP&lt;/b&gt;&lt;br&gt;Needs human review&lt;br&gt;or unsuitable&lt;br&gt;&lt;font color='#50667D'&gt;agent result&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=2;strokeColor=#64748B;fontColor=#203247;fontStyle=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=16;spacingTop=18;" parent="1" vertex="1"><mxGeometry x="818" y="590" width="180" height="110" as="geometry" /></mxCell><mxCell id="step-mcp" value="&lt;b&gt;GRAFANA MCP&lt;/b&gt;&lt;br&gt;History · failures · runtime&lt;br&gt;Scoped read-only evidence&lt;br&gt;&lt;font color='#50667D'&gt;required&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=2;strokeColor=#64748B;fontColor=#203247;fontStyle=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=16;spacingTop=18;" parent="1" vertex="1"><mxGeometry x="1096" y="260" width="226" height="150" as="geometry" /></mxCell><mxCell id="step-receipt" value="&lt;b&gt;EXACT CANDIDATE&lt;/b&gt;&lt;br&gt;Clipping · timing · export&lt;br&gt;Evidence must be nonempty&lt;br&gt;&lt;font color='#50667D'&gt;required&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=2;strokeColor=#64748B;fontColor=#203247;fontStyle=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=16;spacingTop=18;" parent="1" vertex="1"><mxGeometry x="1096" y="530" width="226" height="128" as="geometry" /></mxCell><mxCell id="step-verdict" value="&lt;b&gt;AUDITION + VERDICT&lt;/b&gt;&lt;br&gt;Compare against picture&lt;br&gt;Approve or reject&lt;br&gt;&lt;font color='#50667D'&gt;human&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeWidth=2;strokeColor=#FF5A36;fontColor=#203247;fontStyle=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=16;spacingTop=18;" parent="1" vertex="1"><mxGeometry x="1394" y="680" width="158" height="144" as="geometry" /></mxCell><mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=3;dashed=1;dashPattern=13 9;strokeColor=#FF5A36;" parent="1" edge="1" source="step-input" target="step-boundary"><mxGeometry x="0" y="0" width="0" height="0" as="geometry" relative="1" /></mxCell><mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;roun