<mxfile host="app.diagrams.net" version="26.0.14"><diagram id="orpheus-agent-fit-loop" name="Agent fit loop"><mxGraphModel dx="1600" dy="940" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="940" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="ORPHEUS / HOW THE AGENT FITS ONE PART" style="shape=label;html=1;fontSize=29;fontStyle=1;fontColor=#203247;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="24" y="20" width="700" height="34" as="geometry" /></mxCell><mxCell id="sub" value="A bounded agent improves a real Foley take; it never becomes the editor of the whole film." style="shape=label;html=1;fontSize=13;fontColor=#50667D;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="24" y="56" width="800" height="22" as="geometry" /></mxCell><mxCell id="agent-boundary" value="" style="rounded=1;html=1;fillColor=#FFFFFF;strokeWidth=2;strokeColor=#5B7591;" parent="1" vertex="1"><mxGeometry x="270" y="92" width="776" height="750" as="geometry" /></mxCell><mxCell id="agent-boundary-label" value="ORPHEUS / ONE SELECTED PART" style="shape=label;html=1;align=left;verticalAlign=middle;fontColor=#203247;fontStyle=1;fontSize=16;" parent="1" vertex="1"><mxGeometry x="298" y="96" width="320" height="20" as="geometry" /></mxCell><mxCell id="domain-10" value="" style="rounded=1;html=1;fillColor=#FBFCFD;strokeWidth=2;strokeColor=#8095AA;" parent="1" vertex="1"><mxGeometry x="24" y="104" width="222" height="738" as="geometry" /></mxCell><mxCell id="domain-label-10" value="CREATOR INPUT" style="shape=label;html=1;align=left;verticalAlign=middle;fontColor=#203247;fontStyle=1;fontSize=16;" parent="1" vertex="1"><mxGeometry x="56" y="120" width="174" height="20" as="geometry" /></mxCell><mxCell id="domain-note-10" value="explicit consent" style="shape=label;html=1;align=left;verticalAlign=middle;fontColor=#50667D;fontSize=11;" parent="1" vertex="1"><mxGeometry x="56" y="140" width="174" height="18" as="geometry" /></mxCell><mxCell id="domain-11" value="" style="rounded=1;html=1;fillColor=#FBFCFD;strokeWidth=2;strokeColor=#8095AA;" parent="1" vertex="1"><mxGeometry x="296" y="138" width="230" height="332" as="geometry" /></mxCell><mxCell id="domain-label-11" value="PART + BASELINE" style="shape=label;html=1;align=left;verticalAlign=middle;fontColor=#203247;fontStyle=1;fontSize=16;" parent="1" vertex="1"><mxGeometry x="328" y="154" width="182" height="20" as="geometry" /></mxCell><mxCell id="domain-note-11" value="fixed starting point" style="shape=label;html=1;align=left;verticalAlign=middle;fontColor=#50667D;fontSize=11;" parent="1" vertex="1"><mxGeometry x="328" y="174" width="182" height="18" as="geometry" /></mxCell><mxCell id="domain-12" value="" style="rounded=1;html=1;fillColor=#FBFCFD;strokeWidth=2;strokeColor=#8095AA;" parent="1" vertex="1"><mxGeometry x="546" y="138" width="228" height="332" as="geometry" /></mxCell><mxCell id="domain-label-12" value="AGENT SESSION" style="shape=label;html=1;align=left;verticalAlign=middle;fontColor=#203247;fontStyle=1;fontSize=16;" parent="1" vertex="1"><mxGeometry x="578" y="154" width="180" height="20" as="geometry" /></mxCell><mxCell id="domain-note-12" value="bounded paid turn" style="shape=label;html=1;align=left;verticalAlign=middle;fontColor=#50667D;fontSize=11;" parent="1" vertex="1"><mxGeometry x="578" y="174" width="180" height="18" as="geometry" /></mxCell><mxCell id="domain-13" value="" style="rounded=1;html=1;fillColor=#FBFCFD;strokeWidth=2;strokeColor=#8095AA;" parent="1" vertex="1"><mxGeometry x="296" y="494" width="478" height="244" as="geometry" /></mxCell><mxCell id="domain-label-13" value="LOCAL FIT TOOLS" style="shape=label;html=1;align=left;verticalAlign=middle;fontColor=#203247;fontStyle=1;fontSize=16;" parent="1" vertex="1"><mxGeometry x="328" y="510" width="430" height="20" as="geometry" /></mxCell><mxCell id="domain-n